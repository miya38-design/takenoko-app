rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // アプリが使う4コレクションのみ許可
    match /cfg/main {
      allow read, write: if true;
    }
    match /records/main {
      allow read, write: if true;
    }
    match /names/main {
      allow read, write: if true;
    }
    match /history/{date} {
      allow read, write: if true;
    }

    // 上記以外は全拒否（不正な新コレクション作成・全スキャンを防ぐ）
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
